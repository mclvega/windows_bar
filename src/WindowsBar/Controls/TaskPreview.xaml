<UserControl x:Class="WindowsBar.Controls.TaskPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsBar.Controls"
             Unloaded="TaskPreview_Unloaded">
    <!-- Sin transparencia: DWM no dibuja miniaturas en ventanas con transparencia por píxel -->
    <Popup x:Name="PreviewPopup" Placement="Custom" StaysOpen="True" AllowsTransparency="False"
           Opened="PreviewPopup_Opened" Closed="PreviewPopup_Closed">
        <Border x:Name="PopupRoot" Background="{StaticResource MenuBackground}" BorderBrush="{StaticResource MenuBorder}"
                BorderThickness="1" Padding="6"
                MouseEnter="PopupRoot_MouseEnter" MouseLeave="PopupRoot_MouseLeave">
            <ItemsControl x:Name="Cards" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" CornerRadius="6" Padding="8,6,8,8" Margin="2" Background="Transparent"
                                MouseLeftButtonUp="Card_MouseLeftButtonUp">
                            <StackPanel Width="200">
                                <DockPanel Height="24" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Width="24" Height="24"
                                            ToolTip="Cerrar ventana" Click="CloseWindow_Click">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE711;" />
                                    </Button>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Style="{StaticResource BarText}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Grid Width="200" Height="112">
                                    <!-- Se ve si la ventana está minimizada (DWM no tiene contenido que mostrar) -->
                                    <Image Source="{Binding AppIcon}" Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <local:WindowThumbnail SourceHandle="{Binding Handle}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource ActiveBackground}" />
                            </DataTrigger>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Popup>
</UserControl>
