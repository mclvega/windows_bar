<UserControl x:Class="WindowsBar.Controls.TaskButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="TaskButton_Loaded"
             Unloaded="TaskButton_Unloaded">
    <Button x:Name="AppButton"
            Style="{StaticResource SquareBarButton}"
            ToolTip="{Binding ButtonToolTip}"
            MouseEnter="AppButton_MouseEnter"
            MouseLeave="AppButton_MouseLeave"
            PreviewMouseLeftButtonDown="AppButton_PreviewMouseLeftButtonDown"
            Click="AppButton_Click"
            MouseUp="AppButton_MouseUp"
            ContextMenuOpening="AppButton_ContextMenuOpening">
        <Button.ContextMenu>
            <ContextMenu x:Name="Menu" />
        </Button.ContextMenu>
        <Grid Width="44" Height="40">
            <!-- Fondo según estado: activa / requiere atención -->
            <Border CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ActiveBackground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                <Setter Property="Background" Value="{StaticResource FlashBackground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Image Source="{Binding Icon}" Width="{StaticResource TaskIconSize}" Height="{StaticResource TaskIconSize}"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,2" />

            <!-- Número de ventanas abiertas (solo apps ancladas con varias) -->
            <Border MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0"
                    Background="{StaticResource WindowCountBackground}"
                    BorderBrush="{StaticResource BarBackground}" BorderThickness="1.5"
                    Visibility="{Binding ShowWindowCount, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding WindowCountText}" FontFamily="{StaticResource TextFont}"
                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WindowCountForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Progreso (descargas, copias de archivos...) -->
            <ProgressBar Height="3" Margin="9,0,9,6" VerticalAlignment="Bottom" Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Foreground" Value="{StaticResource ProgressNormal}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border x:Name="PART_Track" Background="#33FFFFFF" CornerRadius="1.5" />
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                CornerRadius="1.5" HorizontalAlignment="Left" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProgressError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ProgressError}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsProgressPaused}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ProgressPaused}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <!-- Indicador inferior: gris corto = abierta, azul largo = activa -->
            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="{StaticResource RunningIndicator}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Background" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Button>
</UserControl>
