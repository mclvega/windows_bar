<UserControl x:Class="WindowsBar.Controls.TrayArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsBar.Controls">
    <StackPanel Orientation="Horizontal">

        <!-- Botón ^ : iconos ocultos -->
        <Button x:Name="ChevronButton" Style="{StaticResource BarButton}" Width="24" Height="40"
                ToolTip="Mostrar iconos ocultos" Click="ChevronButton_Click">
            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE70E;" />
        </Button>

        <Popup x:Name="OverflowPopup" PlacementTarget="{Binding ElementName=ChevronButton}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-10"
               Opened="OverflowPopup_Opened" Closed="OverflowPopup_Closed">
            <Border Background="{StaticResource MenuBackground}" BorderBrush="{StaticResource MenuBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
                <ItemsControl x:Name="OverflowItems" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel MaxWidth="180" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:TrayIcon IconWidth="34" IconHeight="34" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>

        <!-- Iconos visibles en la barra -->
        <ItemsControl x:Name="VisibleItems" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:TrayIcon Margin="1,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Globo de notificación de apps de bandeja -->
        <Popup x:Name="BalloonPopup" PlacementTarget="{Binding ElementName=VisibleItems}" Placement="Top"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Slide" VerticalOffset="-10">
            <Border Background="{StaticResource MenuBackground}" BorderBrush="{StaticResource MenuBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Width="340" Cursor="Hand"
                    MouseLeftButtonUp="Balloon_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="BalloonIcon" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="BalloonTitle" Style="{StaticResource BarText}" FontSize="14"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="BalloonText" Style="{StaticResource BarText}" FontSize="13"
                                   Foreground="{StaticResource ForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BarButton}" Width="24" Height="24"
                            VerticalAlignment="Top" Click="BalloonClose_Click">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
