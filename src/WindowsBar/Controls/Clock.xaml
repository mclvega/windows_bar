<UserControl x:Class="WindowsBar.Controls.Clock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Style="{StaticResource BarButton}" Height="40" Padding="8,0" Margin="1,0"
            ToolTip="{Binding ToolTip}" Click="Clock_Click">
        <Button.ContextMenu>
            <ContextMenu Placement="Top">
                <MenuItem Header="Ajustar fecha y hora" Click="DateTimeSettings_Click" />
                <MenuItem Header="Centro de notificaciones" Click="Clock_Click" />
            </ContextMenu>
        </Button.ContextMenu>
        <StackPanel>
            <TextBlock Style="{StaticResource BarText}" Text="{Binding Time}" HorizontalAlignment="Right" />
            <TextBlock Style="{StaticResource BarText}" Text="{Binding Date}" HorizontalAlignment="Right" />
        </StackPanel>
    </Button>
</UserControl>
