<UserControl x:Class="WindowsBar.Controls.TrayIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="IconBorder"
            Width="{Binding IconWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Height="{Binding IconHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CornerRadius="4"
            ToolTip="{Binding Title}"
            MouseDown="Icon_MouseDown"
            MouseUp="Icon_MouseUp"
            MouseEnter="Icon_MouseEnter"
            MouseLeave="Icon_MouseLeave"
            MouseMove="Icon_MouseMove">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverBackground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Image Source="{Binding Icon, Mode=OneWay}" Width="16" Height="16"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Border>
</UserControl>
