<appbar:AppBarWindow x:Class="WindowsBar.Views.TaskbarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
                     xmlns:controls="clr-namespace:WindowsBar.Controls"
                     Title="WindowsBar"
                     Background="Transparent"
                     FontFamily="{StaticResource TextFont}">

    <Window.ContextMenu>
        <ContextMenu Opened="BarContextMenu_Opened">
            <MenuItem Header="Administrador de tareas" Click="TaskManager_Click" />
            <Separator />
            <MenuItem x:Name="DragReorderMenuItem" Header="Cambiar el orden de las apps arrastrando"
                      IsCheckable="True" Click="DragReorder_Click" />
            <MenuItem Header="Configuración de WindowsBar" Click="WindowsBarSettings_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Fondo en el borde raíz: con "ocultar automáticamente" este borde es el que se desliza -->
    <Border x:Name="RootBorder" Background="{StaticResource BarBackground}"
            BorderBrush="{StaticResource BarBorder}" BorderThickness="0,1,0,0">
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>
        <controls:CenteringPanel x:Name="Layout">
            <!-- Izquierda: Widgets -->
            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                <controls:WidgetsButton x:Name="WidgetsButton" />
            </StackPanel>

            <!-- Centro: Inicio, Búsqueda, Vista de tareas y apps -->
            <StackPanel Orientation="Horizontal">
                <controls:StartButton />
                <controls:SearchButton x:Name="SearchButton" />
                <controls:TaskViewButton x:Name="TaskViewButton" />
                <controls:TaskList x:Name="TaskList" />
                <!-- Vistas previas de las ventanas (solo contiene un popup: no ocupa espacio) -->
                <controls:TaskPreview x:Name="TaskPreview" />
            </StackPanel>

            <!-- Derecha: bandeja, iconos del sistema, reloj y Mostrar escritorio -->
            <StackPanel Orientation="Horizontal">
                <controls:TrayArea x:Name="TrayArea" />
                <controls:SystemIcons />
                <controls:Clock />
                <controls:ShowDesktopButton x:Name="ShowDesktopButton" />
            </StackPanel>
        </controls:CenteringPanel>
    </Border>
</appbar:AppBarWindow>
